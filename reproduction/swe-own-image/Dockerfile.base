FROM scratch
ADD ubuntu-base-22.04.5-base-amd64.tar.gz /
LABEL continuum.image.owner="ext.luohaowen1" continuum.image.purpose="independent-swebench-base"
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget git build-essential libffi-dev libtiff-dev \
    libmemcached-dev zlib1g-dev python3 python3-pip python-is-python3 \
    jq locales locales-all tzdata \
    && rm -rf /var/lib/apt/lists/*
COPY Miniforge3-26.7.2-0-Linux-x86_64.sh /tmp/miniforge.sh
RUN echo '281b0ac7d550802efc81af633225a5e6116d29ae72f3ab4eae7168c3931a4c05  /tmp/miniforge.sh' | sha256sum --check \
    && bash /tmp/miniforge.sh -b -p /opt/miniconda3 \
    && /opt/miniconda3/bin/conda clean --all --yes \
    && rm /tmp/miniforge.sh
ENV PATH=/opt/miniconda3/bin:$PATH
ENV PYTHONNOUSERSITE=1 PIP_DISABLE_PIP_VERSION_CHECK=1
ENV NVIDIA_VISIBLE_DEVICES=void CUDA_VISIBLE_DEVICES=""
WORKDIR /testbed
CMD ["/bin/bash"]
